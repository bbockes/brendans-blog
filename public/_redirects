# Redirect trailing slashes to non-trailing slash URLs for posts only
/posts/*/ /posts/:splat 301

# Redirect Netlify domain to custom domain (SEO)
# This must come before the SPA fallback
https://brendansblog.netlify.app/* https://blog.brendanbockes.com/:splat 301!
https://main--brendansblog.netlify.app/* https://blog.brendanbockes.com/:splat 301!

# Redirect www subdomain to non-www
https://www.blog.brendanbockes.com/* https://blog.brendanbockes.com/:splat 301!

# WordPress-compatible publishing bridge, so Ulysses can publish into Sanity.
# Rules in this file are evaluated before netlify.toml, so these have to live
# here to win against the SPA fallback below.
/wp-json /.netlify/functions/wordpress-bridge/wp-json 200!
/wp-json/* /.netlify/functions/wordpress-bridge/wp-json/:splat 200!
/wp-admin/authorize-application.php /.netlify/functions/wordpress-bridge/wp-admin/authorize-application.php 200!

# Serve the RSS feed from the function rather than the copy written at build
# time. The "!" is what matters: without it the generated dist/feed.xml file
# wins and scheduled posts stay out of the feed until the next deploy.
/feed.xml /.netlify/functions/rss-feed 200!

# Fallback to SPA for client-side routing
# React router will handle both /about and /about/ routes
/* /index.html 200